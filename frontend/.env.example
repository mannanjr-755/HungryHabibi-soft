# BonPainer dashboard — Neon PostgreSQL
# Dashboard and Digital Menu share the same database so kitchen orders
# from the menu appear on this dashboard.
# Omit channel_binding=require (Prisma does not support it). Prefer:
# ?sslmode=require&connect_timeout=30&pool_timeout=30&pgbouncer=true
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30&pgbouncer=true"

# Generate with: npx auth secret
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3001"
AUTH_TRUST_HOST="true"
# PIN required to open Reports in the dashboard (default 1234 if unset)
REPORTS_PIN="1234"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
# Deployed Digital Menu URL
NEXT_PUBLIC_SITE_URL="https://BonPainer-menu.vercel.app"
